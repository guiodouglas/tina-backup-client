# backup-client 2.0: só o que é próprio deste servidor.
# O horário fica no crontab; limites de disco/memória e margens ficam no banco da TINA.
# Permissão do arquivo: 600 (contém senhas). Nunca circule este arquivo preenchido.

# Identidade (nome lógico do servidor no banco da TINA)
SERVER_NAME=
TZ=America/Sao_Paulo

# Google Drive: um Shared Drive por dia útil (espelho de backup_sources menos backup_excludes)
RCLONE_REMOTE=gdrive
RCLONE_TEAM_DRIVE_SEGUNDA=
RCLONE_TEAM_DRIVE_TERCA=
RCLONE_TEAM_DRIVE_QUARTA=
RCLONE_TEAM_DRIVE_QUINTA=
RCLONE_TEAM_DRIVE_SEXTA=
# Credencial do rclone (conta do Drive), no formato de variáveis do rclone:
# RCLONE_CONFIG_GDRIVE_TYPE=drive
# RCLONE_CONFIG_GDRIVE_SCOPE=drive
# RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":...}'

# FTP do TAR.GZ
FTP_BACKUP_HOST=
FTP_BACKUP_PORT=21
FTP_BACKUP_USER=
FTP_BACKUP_PASSWORD=
FTP_BACKUP_REMOTE_DIR=/
# Quantos backups do servidor ficam no FTP (mínimo 2). Antes de enviar o novo, o mais
# antigo (<servidor>_AAAA-MM-DD.tar.gz) é apagado para que, depois do envio, fiquem estes.
FTP_BACKUP_RETENCAO=3

# Banco da TINA (usuário único de entrega, igual em todos os servidores)
TINA_DB_HOST=tina.ti9.com.br
TINA_DB_PORT=54323
TINA_DB_NAME=tina
TINA_DB_USER=backup_client
TINA_DB_PASSWORD=

# Opcionais (padrões entre parênteses)
# BACKUP_ARCHIVE_DIR=/tmp/backup-client   (onde o TAR fica até ser enviado)
# LOG_RETENTION_DAYS=30
